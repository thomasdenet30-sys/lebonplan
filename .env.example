# LEBONPLAN — variables d'environnement (exemple)
# Copie ce fichier en .env et renseigne tes valeurs (Supabase → Project Settings → API).
# NB : le front (js/config.js) utilise la clé ANON publique — jamais la service_role côté client.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# La clé service_role ne sert QUE côté serveur / scripts d'admin. Ne la mets jamais dans le front.
SUPABASE_SERVICE_ROLE_KEY=
